{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/Demi_Head/schemas/nexus-endpoint-policy.schema.json",
  "title": "JANUS Nexus Endpoint Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "endpoint_id",
    "enabled",
    "accepted_target_heads",
    "local_dispatch_only",
    "external_effect_permitted",
    "authority_delta",
    "mass_effect_budget_delta"
  ],
  "properties": {
    "schema": {"const": "janus.demihead.nexus_endpoint_policy.v1"},
    "endpoint_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "enabled": {"type": "boolean"},
    "accepted_target_heads": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PORTAL",
          "OBSERVER",
          "HRAIN",
          "INAIHR",
          "BICAMERAL_BRIDGE",
          "FUNDAMENTUM",
          "GUARDIAN",
          "RELEASE_CONTROL",
          "REGISTRY"
        ]
      }
    },
    "local_dispatch_only": {"const": true},
    "external_effect_permitted": {"const": false},
    "authority_delta": {"const": 0},
    "mass_effect_budget_delta": {"const": 0}
  }
}
