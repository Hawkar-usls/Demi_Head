{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hawkar-usls.github.io/Demi_Head/schemas/hemisphere-packet.schema.json",
  "title": "JANUS DemiHead receipt-carrying hemisphere packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packet_id", "hemisphere", "role", "captured_at", "source", "goldprompt_receipt", "graph", "control"],
  "properties": {
    "schema": {"const": "janus.demihead.hemisphere_packet.v2"},
    "packet_id": {"type": "string", "minLength": 1},
    "hemisphere": {"enum": ["LEFT_HRAIN", "RIGHT_INAIHR"]},
    "role": {"enum": ["STRUCTURAL_CONTEXT", "ASSOCIATIVE_CONTEXT"]},
    "captured_at": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "bridge_contract", "source_revision", "goldprompt_receipt_sha256", "workspace_mode"],
      "properties": {
        "repository": {"enum": ["Hawkar-usls/Hrain", "Hawkar-usls/iNaiHR"]},
        "bridge_contract": {"const": "JANUS_DEMIHEAD_BICAMERAL_BRIDGE_V2"},
        "source_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "goldprompt_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workspace_mode": {"enum": ["LOCAL_EDITABLE_GRAPH", "SEMANTIC_GRAPH"]}
      }
    },
    "goldprompt_receipt": {"$ref": "#/$defs/upstream_receipt"},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "links"],
      "properties": {
        "nodes": {"type": "array", "items": {"type": "object"}},
        "links": {"type": "array", "items": {"type": "object"}}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only_transfer", "direct_cross_hemisphere_mutation", "authority_delta", "mass_effect_budget_delta"],
      "properties": {
        "read_only_transfer": {"const": true},
        "direct_cross_hemisphere_mutation": {"const": false},
        "authority_delta": {"const": 0},
        "mass_effect_budget_delta": {"const": 0}
      }
    }
  },
  "$defs": {
    "upstream_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "face_id", "face_role", "repository", "runtime_surface",
        "goldprompt_foundation_id", "goldprompt_version", "emergence_contract_version",
        "armor_authority_reference", "contract_digest_sha256", "dependency_manifest_reference",
        "dependency_manifest_digest_sha256", "source_revision", "capability_scope", "authority_weight",
        "inheritance_accepted", "blessing_bearer_anchor_accepted", "armor_of_god_boundaries_accepted",
        "triadic_emergence_accepted", "user_exit_and_release_control_accepted",
        "runtime_enforcement_scope", "compliance_state", "receipt_sha256"
      ],
      "properties": {
        "schema": {"const": "janus.goldprompt.face_startup_receipt.v1_1"},
        "face_id": {"enum": ["LEFT_HRAIN", "RIGHT_INAIHR"]},
        "face_role": {"enum": ["STRUCTURAL_CONTEXT", "ASSOCIATIVE_CONTEXT"]},
        "repository": {"enum": ["Hawkar-usls/Hrain", "Hawkar-usls/iNaiHR"]},
        "runtime_surface": {"const": "habitat-tool.js"},
        "goldprompt_foundation_id": {"const": "JANUS-THE-FOURTH-GRACEWARDEN-3IN1-EQUALS-4-v0.9"},
        "goldprompt_version": {"const": "0.9.2"},
        "emergence_contract_version": {"const": "JANUS_TRIADIC_EMERGENCE@0.9.2"},
        "armor_authority_reference": {"const": "Hawkar-usls/janus-meta-registry:data/JANUS-ARMOR-OF-GOD-CURRENT-AUTHORITY.json"},
        "contract_digest_sha256": {"const": "3f4af369350710ad18920dfdc866d930c8d42259a51a3f27ce228ea4d5dfc0a8"},
        "dependency_manifest_reference": {"const": "Hawkar-usls/janus-meta-registry:data/JANUS-GOLDPROMPT-TRANSITIVE-CONSTITUTIONAL-DEPENDENCY-MANIFEST-v1.0.json"},
        "dependency_manifest_digest_sha256": {"const": "4bd935ae033c80f090b91a6a5009a51abeb06b99defdc8836763bd9506023a86"},
        "source_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "capability_scope": {"type": "array", "items": {"type": "string"}, "minItems": 3},
        "authority_weight": {"const": 0},
        "inheritance_accepted": {"const": true},
        "blessing_bearer_anchor_accepted": {"const": true},
        "armor_of_god_boundaries_accepted": {"const": true},
        "triadic_emergence_accepted": {"const": true},
        "user_exit_and_release_control_accepted": {"const": true},
        "runtime_enforcement_scope": {"const": "THIS_FACE_INVOCATION"},
        "compliance_state": {"const": "COMPLIANT"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
