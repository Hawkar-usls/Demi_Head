{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hawkar-usls.github.io/Demi_Head/schemas/hemisphere-packet.schema.json",
  "title": "JANUS DemiHead hemisphere packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_id",
    "hemisphere",
    "role",
    "captured_at",
    "source",
    "graph",
    "control"
  ],
  "properties": {
    "schema": {"const": "janus.demihead.hemisphere_packet.v1"},
    "packet_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "hemisphere": {"enum": ["LEFT_HRAIN", "RIGHT_INAIHR"]},
    "role": {"enum": ["STRUCTURAL_CONTEXT", "ASSOCIATIVE_CONTEXT"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "bridge_contract", "source_revision", "workspace_mode"],
      "properties": {
        "repository": {"enum": ["Hawkar-usls/Hrain", "Hawkar-usls/iNaiHR"]},
        "bridge_contract": {"const": "JANUS_DEMIHEAD_BICAMERAL_BRIDGE_V1"},
        "source_revision": {"type": ["string", "null"], "minLength": 1},
        "workspace_mode": {"enum": ["LOCAL_EDITABLE_GRAPH", "SEMANTIC_GRAPH"]}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "links"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "origin"],
            "properties": {
              "id": {"type": ["string", "integer"]},
              "label": {"type": "string", "minLength": 1, "maxLength": 2048},
              "origin": {"enum": ["USER", "REMOTE_AI", "LOCAL_FALLBACK", "LEGACY_UNKNOWN", "SYSTEM"]},
              "type": {"type": "string", "maxLength": 64},
              "is_ai": {"type": "boolean"}
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": {"type": ["string", "integer"]},
              "target": {"type": ["string", "integer"]}
            }
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only_transfer",
        "direct_cross_hemisphere_mutation",
        "authority_delta",
        "mass_effect_budget_delta"
      ],
      "properties": {
        "read_only_transfer": {"const": true},
        "direct_cross_hemisphere_mutation": {"const": false},
        "authority_delta": {"const": 0},
        "mass_effect_budget_delta": {"const": 0}
      }
    }
  }
}
