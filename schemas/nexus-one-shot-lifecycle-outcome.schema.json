{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus.local/schemas/nexus-one-shot-lifecycle-outcome.schema.json",
  "title": "JANUS Nexus one-shot lifecycle local outcome",
  "type": "object",
  "required": ["schema", "contract", "status", "lifecycle", "control"],
  "properties": {
    "schema": {"const": "janus.demihead.nexus_one_shot_lifecycle_outcome.v1"},
    "contract": {"const": "JANUS_NEXUS_ONE_SHOT_LIFECYCLE_GATE_V1"},
    "status": {"type": "string", "minLength": 1},
    "lifecycle": {
      "type": "object",
      "required": ["service_id", "instance_id", "phase", "detail_code", "wire_receipt_send_completed", "manual_ack_required"],
      "properties": {
        "service_id": {"type": "string", "minLength": 1},
        "instance_id": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "detail_code": {"type": "string", "minLength": 1},
        "wire_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "wire_receipt_send_completed": {"type": "boolean"},
        "manual_ack_required": {"type": "boolean"}
      }
    },
    "dispatch": {"type": "object"},
    "control": {
      "type": "object",
      "required": ["automatic_start_permitted", "automatic_restart_permitted", "automatic_retry_permitted", "external_effect_permitted", "authority_delta", "mass_effect_budget_delta"],
      "properties": {
        "automatic_start_permitted": {"const": false},
        "automatic_restart_permitted": {"const": false},
        "automatic_retry_permitted": {"const": false},
        "external_effect_permitted": {"const": false},
        "authority_delta": {"const": 0},
        "mass_effect_budget_delta": {"const": 0}
      }
    },
    "claim_ceiling": {"type": "object"}
  }
}
