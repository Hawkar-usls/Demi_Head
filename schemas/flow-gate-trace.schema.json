{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/Demi_Head/schemas/flow-gate-trace.schema.json",
  "title": "JANUS DemiHead bounded flow-gate trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "config", "work"],
  "properties": {
    "schema": {"const": "janus.demihead.flow_gate_trace.v1"},
    "trace_id": {"type": "string", "minLength": 1},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quota", "max_waves"],
      "properties": {
        "quota": {"type": "integer", "minimum": 1},
        "max_waves": {"type": "integer", "minimum": 1}
      }
    },
    "work": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "observed_outcome"],
        "properties": {
          "work_id": {"type": "string", "minLength": 1},
          "observed_outcome": {"enum": ["completed", "failed", "unknown"]}
        }
      }
    }
  }
}
