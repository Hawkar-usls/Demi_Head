  "properties": {
    "schema": {"const": "janus.demihead.cosmos_proof_request.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "operation": {"const": "VERIFY_CANONICAL_GATE"},
    "intent_anchor": {"type": "object"},
    "intent_handoff": {"type": "object"},
    "provider_repository": {"const": "Hawkar-usls/Janus-Cosmos"},
    "provider_sha": {"const": "c77f920d764229efb6932bc4ea522a4ec0342c64"},
    "canonical_gate": {"const": "S𓂸ḥ/2"},
    "input_payload": {"type": "object"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
