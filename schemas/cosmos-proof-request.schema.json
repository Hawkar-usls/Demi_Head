{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "janus.demihead.cosmos_proof_request.v1",
  "title": "DemiHead intent-bound Janus-Cosmos proof request",
  "type": "object",
  "required": [
    "schema",
    "request_id",
    "operation",
    "intent_anchor",
    "intent_handoff",
