{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hawkar-usls.github.io/Demi_Head/schemas/bicameral-result.schema.json",
  "title": "JANUS DemiHead bicameral result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "goldprompt_receipt", "upstream_goldprompt_receipts", "receipt_chain",
    "status", "hemispheres_present", "packet_receipts", "comparison", "routing", "claim_ceiling"
  ],
  "properties": {
    "schema": {"const": "janus.demihead.bicameral_result.v2"},
    "goldprompt_receipt": {"$ref": "#/$defs/demihead_receipt"},
    "upstream_goldprompt_receipts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "LEFT_HRAIN": {"$ref": "#/$defs/upstream_receipt"},
        "RIGHT_INAIHR": {"$ref": "#/$defs/upstream_receipt"}
      },
      "minProperties": 1, "maxProperties": 2
    },
    "receipt_chain": {"$ref": "#/$defs/receipt_chain"},
    "status": {"enum": ["BICAMERAL_OVERLAP_PRESENT", "BICAMERAL_DIVERGENCE_PRESERVED", "DEGRADED_SINGLE_HEMISPHERE"]},
    "hemispheres_present": {"type": "array", "uniqueItems": true, "items": {"enum": ["LEFT_HRAIN", "RIGHT_INAIHR"]}, "minItems": 1, "maxItems": 2},
    "packet_receipts": {
      "type": "object", "additionalProperties": false,
      "properties": {"LEFT_HRAIN": {"$ref": "#/$defs/packet_receipt"}, "RIGHT_INAIHR": {"$ref": "#/$defs/packet_receipt"}},
      "minProperties": 1, "maxProperties": 2
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["shared_semantic_keys", "left_only_semantic_keys", "right_only_semantic_keys", "automatic_graph_merge_performed"],
      "properties": {
        "shared_semantic_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "left_only_semantic_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "right_only_semantic_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "automatic_graph_merge_performed": {"const": false}
      }
    },
    "routing": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "external_effect_permitted", "direct_cross_hemisphere_write_permitted", "disagreement_preserved"],
      "properties": {
        "mode": {"enum": ["BICAMERAL_REVIEW", "DEGRADED_SINGLE_HEMISPHERE_HOLD"]},
        "external_effect_permitted": {"const": false},
        "direct_cross_hemisphere_write_permitted": {"const": false},
        "disagreement_preserved": {"const": true}
      }
    },
    "claim_ceiling": {
      "type": "object", "additionalProperties": false,
      "required": ["truth_claim_made", "agreement_is_truth", "hemisphere_count_is_authority", "association_is_evidence", "structure_is_command", "authority_delta", "mass_effect_budget_delta"],
      "properties": {
        "truth_claim_made": {"const": false}, "agreement_is_truth": {"const": false},
        "hemisphere_count_is_authority": {"const": false}, "association_is_evidence": {"const": false},
        "structure_is_command": {"const": false}, "authority_delta": {"const": 0}, "mass_effect_budget_delta": {"const": 0}
      }
    }
  },
  "$defs": {
    "packet_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["packet_id", "sha256", "repository", "source_revision", "upstream_goldprompt_receipt_sha256", "node_count", "link_count", "origin_counts"],
      "properties": {
        "packet_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "repository": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "upstream_goldprompt_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "node_count": {"type": "integer", "minimum": 0}, "link_count": {"type": "integer", "minimum": 0},
        "origin_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["USER", "REMOTE_AI", "LOCAL_FALLBACK", "LEGACY_UNKNOWN", "SYSTEM"],
          "properties": {"USER":{"type":"integer","minimum":0},"REMOTE_AI":{"type":"integer","minimum":0},"LOCAL_FALLBACK":{"type":"integer","minimum":0},"LEGACY_UNKNOWN":{"type":"integer","minimum":0},"SYSTEM":{"type":"integer","minimum":0}}
        }
      }
    },
    "receipt_common": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "face_id", "face_role", "repository", "runtime_surface", "goldprompt_foundation_id",
        "goldprompt_version", "emergence_contract_version", "armor_authority_reference", "contract_digest_sha256",
        "dependency_manifest_reference", "dependency_manifest_digest_sha256", "source_revision", "capability_scope",
        "authority_weight", "inheritance_accepted", "blessing_bearer_anchor_accepted", "armor_of_god_boundaries_accepted",
        "triadic_emergence_accepted", "user_exit_and_release_control_accepted", "runtime_enforcement_scope", "compliance_state", "receipt_sha256"
      ],
      "properties": {
        "schema": {"const": "janus.goldprompt.face_startup_receipt.v1_1"},
        "face_id": {"type": "string"}, "face_role": {"type": "string"}, "repository": {"type": "string"}, "runtime_surface": {"type": "string"},
        "goldprompt_foundation_id": {"const": "JANUS-THE-FOURTH-GRACEWARDEN-3IN1-EQUALS-4-v0.9"},
        "goldprompt_version": {"const": "0.9.2"}, "emergence_contract_version": {"const": "JANUS_TRIADIC_EMERGENCE@0.9.2"},
        "armor_authority_reference": {"const": "Hawkar-usls/janus-meta-registry:data/JANUS-ARMOR-OF-GOD-CURRENT-AUTHORITY.json"},
        "contract_digest_sha256": {"const": "3f4af369350710ad18920dfdc866d930c8d42259a51a3f27ce228ea4d5dfc0a8"},
        "dependency_manifest_reference": {"const": "Hawkar-usls/janus-meta-registry:data/JANUS-GOLDPROMPT-TRANSITIVE-CONSTITUTIONAL-DEPENDENCY-MANIFEST-v1.0.json"},
        "dependency_manifest_digest_sha256": {"const": "4bd935ae033c80f090b91a6a5009a51abeb06b99defdc8836763bd9506023a86"},
        "source_revision": {"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "capability_scope": {"type":"array","items":{"type":"string"},"minItems":3},
        "authority_weight":{"const":0}, "inheritance_accepted":{"const":true}, "blessing_bearer_anchor_accepted":{"const":true},
        "armor_of_god_boundaries_accepted":{"const":true}, "triadic_emergence_accepted":{"const":true}, "user_exit_and_release_control_accepted":{"const":true},
        "runtime_enforcement_scope":{"const":"THIS_FACE_INVOCATION"}, "compliance_state":{"const":"COMPLIANT"},
        "receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    "upstream_receipt": {"$ref": "#/$defs/receipt_common"},
    "demihead_receipt": {"$ref": "#/$defs/receipt_common"},
    "chain_upstream_entry": {
      "type":"object","additionalProperties":false,
      "required":["repository","source_revision","receipt_sha256","packet_sha256"],
      "properties":{"repository":{"type":"string"},"source_revision":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},"receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"packet_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
    },
    "receipt_chain": {
      "type":"object","additionalProperties":false,
      "required":["schema","upstream","demihead","binding_scope","canonical_bicameral_chain_complete","end_to_end_receipt_binding_established","origin_authentication_established","live_process_identity_established","authority_delta","chain_sha256"],
      "properties": {
        "schema":{"const":"janus.goldprompt.receipt_chain.v1"},
        "upstream":{"type":"object","additionalProperties":false,"properties":{"LEFT_HRAIN":{"$ref":"#/$defs/chain_upstream_entry"},"RIGHT_INAIHR":{"$ref":"#/$defs/chain_upstream_entry"}},"minProperties":1,"maxProperties":2},
        "demihead":{"type":"object","additionalProperties":false,"required":["repository","source_revision","receipt_sha256"],"properties":{"repository":{"const":"Hawkar-usls/Demi_Head"},"source_revision":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},"receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
        "binding_scope":{"const":"UPSTREAM_FACE_RECEIPT_TO_PACKET_TO_DEMIHEAD_RESULT"},
        "canonical_bicameral_chain_complete":{"type":"boolean"},
        "end_to_end_receipt_binding_established":{"type":"boolean"},
        "origin_authentication_established":{"const":false},
        "live_process_identity_established":{"const":false},
        "authority_delta":{"const":0},
        "chain_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    }
  }
}
