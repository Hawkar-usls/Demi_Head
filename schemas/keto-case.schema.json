{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/Demi_Head/schemas/keto-case.schema.json",
  "title": "JANUS DemiHead KETO/CETUS Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "claim", "presentations"],
  "properties": {
    "schema": {"const": "janus.demihead.keto_case.v1"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "language"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "language": {"type": "string", "minLength": 2, "maxLength": 16},
        "submitted_by": {"type": ["string", "null"], "maxLength": 160},
        "high_stakes": {"type": "boolean", "default": false}
      }
    },
    "presentations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["presentation_id", "root_id", "source_class", "relation", "freshness"],
        "properties": {
          "presentation_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "root_id": {"type": ["string", "null"], "maxLength": 200},
          "source_class": {
            "type": "string",
            "enum": ["official", "independent_media", "primary_document", "direct_observation", "osint", "derived_media", "social_account", "unknown"]
          },
          "relation": {
            "type": "string",
            "enum": ["supports", "contradicts", "neutral", "unknown"]
          },
          "freshness": {
            "type": "string",
            "enum": ["current", "stale", "unknown"]
          },
          "independence": {
            "type": "string",
            "enum": ["authenticated_independent", "declared_independent", "dependent", "unknown"],
            "default": "unknown"
          },
          "published_at": {"type": ["string", "null"], "format": "date-time"},
          "source_ref": {"type": ["string", "null"], "maxLength": 2048},
          "note": {"type": ["string", "null"], "maxLength": 4000}
        }
      }
    },
    "expected_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mass_effect_budget": {"type": "integer", "minimum": 0, "maximum": 0},
        "allow_objective_truth_label": {"const": false}
      }
    }
  }
}
