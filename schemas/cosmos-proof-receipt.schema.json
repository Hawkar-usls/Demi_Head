{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "janus.demihead.cosmos_proof_receipt.v1",
  "title": "DemiHead Janus-Cosmos proof receipt",
  "type": "object",
  "required": [
    "schema",
    "request_id",
    "request_sha256",
    "intent_id",
    "provider_repository",
    "provider_sha",
    "canonical_gate",
    "input_sha256",
    "cosmos_result_integrity_sha256",
    "cosmos_status",
    "execution_state",
    "evidence_state",
    "P_VS_NP",
    "authority_delta",
    "mass_effect_budget_delta",
    "claim_ceiling",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "janus.demihead.cosmos_proof_receipt.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "intent_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_operation": {"type": "string"},
    "provider_repository": {"const": "Hawkar-usls/Janus-Cosmos"},
    "provider_sha": {"const": "c77f920d764229efb6932bc4ea522a4ec0342c64"},
    "provider_role": {"const": "SPECIALIZED_PROOF_PROVIDER_NOT_TRUTH_ARBITER"},
    "canonical_gate": {"const": "S𓂸ḥ/2"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cosmos_result_integrity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cosmos_status": {"type": "string"},
    "execution_state": {"const": "EXECUTED_AND_REPLAY_VERIFIED"},
    "evidence_state": {"const": "VERIFIED_EXECUTION_PASS_WITHIN_FROZEN_GATE_SCOPE"},
    "definitive_claim_permitted": {"const": true},
    "P_VS_NP": {"const": "OPEN"},
    "P_EQUALS_NP": {"const": "NOT_ESTABLISHED"},
    "P_NOT_EQUALS_NP": {"const": "NOT_ESTABLISHED"},
    "authority_delta": {"const": 0},
    "mass_effect_budget_delta": {"const": 0},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
